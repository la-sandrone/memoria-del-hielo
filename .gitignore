# Memoria del Hielo — .gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# 虚拟环境
.venv/
venv/
env/

# 缓存（嵌入向量缓存不提交，但保留目录结构）
cache/
!cache/.gitkeep

# 图片存储（本地资源不提交）
images/
!images/.gitkeep

# 环境配置（含密码等敏感信息）
.env
*.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# pytest
.pytest_cache/

# 运行日志（本地运行产物：诊断快照 / 夜间任务日志，不提交）
logs/

# 探针草稿（一次性验证脚本，不进版本库）
_scratch/
