       "spans": [
        {
         "bbox": [
          97,
          589,
          300,
          604
         ],
         "type": "text",
         "content": "「现在的人类真是没出生在好时代啊。」"
        }
       ]
      }
     ],
     "index": 9,
     "merge_prev": false
    },
    {
     "bbox": [
